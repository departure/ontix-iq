{
  "name": "ontix-iq",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "dev": "node scripts/run-local.mjs",
    "start": "git submodule update --init && pnpm install && pnpm --dir cloudflare-os install && node scripts/run-local.mjs",
    "test": "node --test scripts/*.test.mjs && pnpm --filter './packages/**' test",
    "typecheck": "pnpm --filter './packages/**' types:check",
    "check": "node scripts/deploy.mjs --check",
    "deploy": "node scripts/deploy.mjs"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.20.1",
    "jsonc-parser": "^3.3.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10",
    "wrangler": "^4.115.0"
  }
}
